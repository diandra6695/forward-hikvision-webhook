{
  "name": "Hikvision Webhook Service",
  "description": "Hikvision attendance webhook processing service",
  "script": "./dist/index.js",
  "nodeOptions": [
    "--max-old-space-size=4096",
    "--enable-source-maps"
  ],
  "env": [
    {
      "name": "NODE_ENV",
      "value": "production"
    },
    {
      "name": "LOG_LEVEL",
      "value": "info"
    }
  ],
  "workingDirectory": "./",
  "maxRetries": 3,
  "maxRestarts": 3,
  "wait": 2,
  "grow": 0.25,
  "abortOnError": false
}